# Complete URL of the existing Smart Monitoring API. Do not include secrets.
VITE_API_BASE_URL=https://your-api-domain/api
# Optional overrides for the existing Smart Monitoring Google OAuth routes.
# The backend must allow-list the web callback and return a one-time `code` to it.
# VITE_GOOGLE_AUTH_START_URL=https://your-api-domain/api/auth/google
# VITE_GOOGLE_AUTH_EXCHANGE_URL=https://your-api-domain/api/auth/google/exchange
# Leave false for every deployed environment. Set true only for local UI work
# when the analytics API is unavailable.
VITE_USE_MOCK_DATA=false
